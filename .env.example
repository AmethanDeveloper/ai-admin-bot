# Токен от @BotFather (обязательно)
BOT_TOKEN=

# ID чата администратора. Можно оставить пустым: администратором станет первый, кто напишет боту /start
ADMIN_CHAT_ID=

# Ключ Claude API с platform.claude.com — для ИИ-ответов на вопросы (необязательно).
# Без ключа бот работает кнопками, ищет ответ в FAQ и пересылает остальное администратору.
ANTHROPIC_API_KEY=

# Модель для ответов (по умолчанию самая дешёвая)
CLAUDE_MODEL=claude-haiku-5-5

# Файл с данными школы — под каждого клиента свой
SCHOOL_FILE=school.json
